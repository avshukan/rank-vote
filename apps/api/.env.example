# PostgreSQL development database started by `make db-up`
DATABASE_URL="postgresql://rank_vote:rank_vote@localhost:5432/rank_vote?schema=public"

# Port to listen on
PORT=3000

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Exact number of trusted reverse-proxy hops; keep zero when the API is direct
TRUSTED_PROXY_HOPS=0
