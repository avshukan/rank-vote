{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "handoff": "user-invocable-only",
    "retro": "user-invocable-only"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr checks:*)",
      "Bash(gh pr checks *)",
      "Bash(pnpm -v)",
      "Bash(make help)",
      "Bash(make verify)",
      "Bash(make format-check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make render-app:*)",
      "Bash(make render-app *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/.env)", "Read(./**/.env.*)"]
  }
}
